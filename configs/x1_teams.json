{
  "_doc": "X1: ten fixed centralized teams (docs/x1-plan.md on the docs branch). Personas run on the base 4B with thinking off; specialists run in every mode listed (stage 1 records both), and 'headline' is the mode the main team result uses. Sampling is each model's vendor setting per mode, as in the 2026-10-23 thinking on/off test. Read by scripts/x1_plan.py (stage 1) and scripts/x1_hub.py (stage 2).",
  "settings": {
    "folds": 5,
    "split_seed": 0,
    "samples": 3,
    "hard": {"max_tokens": 30720, "thinking_budget": 26624, "workers": 8},
    "agentic": {"max_tokens": 8192, "thinking_budget": 6144, "workers": 4},
    "request_timeout": 54000
  },
  "sampling": {
    "qwen_on": "--temperature 1.0 --top_p 0.95 --top_k 20 --min_p 0 --presence_penalty 1.5",
    "qwen_off": "--temperature 0.7 --top_p 0.8 --top_k 20 --min_p 0 --presence_penalty 1.5",
    "gemma": "--temperature 1.0 --top_p 0.95 --top_k 64",
    "agents_a1_on": "--temperature 0.85 --top_p 0.95 --top_k 20 --presence_penalty 1.1",
    "r2s_off": "--temperature 0.4 --top_p 0.95",
    "skillgym_on": "--temperature 0.6 --top_p 0.95 --top_k 20",
    "aquila_on": "--temperature 1.0 --top_p 0.95 --repetition_penalty 1.05",
    "ministral": "--temperature 0.7 --top_p 0.95"
  },
  "persona_model": {"handle": "Qwen/Qwen3.5-4B", "profile": "qwen4b", "quant": "fp8", "mode": "off", "sampling": "qwen_off"},
  "hub": {"handle": "nvidia/Qwen3.6-35B-A3B-NVFP4", "profile": "qwen35b", "quant": "", "mode": "off", "sampling": "qwen_off"},
