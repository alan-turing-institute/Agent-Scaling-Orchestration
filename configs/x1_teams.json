    "r2s": {"handle": "TreezzZ/r2s-alfworld-qwen3.5-4b-student", "profile": "qwen4b", "quant": "fp8",
            "modes": {"off": "r2s_off", "on": "qwen_on"}, "headline": "off"},
    "skillgym": {"handle": "reasonwang/SkillGym-Qwen3.5-4B", "profile": "qwen4b", "quant": "fp8",
